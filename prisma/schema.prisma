// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           String    @default("user") // "admin" or "user"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  purchases      Purchase[]
  hasAccess      Boolean    @default(false)
  referralCodes  ReferralCode[]
  referralUses   ReferralUse[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_token     String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Purchase {
  id            String   @id @default(cuid())
  userId        String
  amount        Int
  currency      String   @default("usd")
  status        String   // pending, completed, failed
  paymentId     String?  // Stripe payment intent ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accessGranted Boolean  @default(false)
  referralUse   ReferralUse?
  commission    Commission?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReferralCode {
  id              String       @id @default(cuid())
  code            String       @unique
  userId          String
  discountPercent Int         // 0-100
  commissionRate  Int         // 0-100
  isActive        Boolean     @default(true)
  maxUses         Int?
  expiresAt       DateTime?
  oneTimePerUser  Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  uses           ReferralUse[]
  commissions    Commission[]
}

model ReferralUse {
  id              String       @id @default(cuid())
  referralCodeId  String
  userId          String
  purchaseId      String      @unique
  discountAmount  Int         // in cents
  finalPrice      Int         // in cents
  createdAt       DateTime    @default(now())

  referralCode    ReferralCode @relation(fields: [referralCodeId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  purchase        Purchase     @relation(fields: [purchaseId], references: [id])
}

model Commission {
  id              String       @id @default(cuid())
  referralCodeId  String
  purchaseId      String      @unique
  amount          Int         // in cents
  status          String      // pending, paid, cancelled
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  referralCode    ReferralCode @relation(fields: [referralCodeId], references: [id])
  purchase        Purchase     @relation(fields: [purchaseId], references: [id])
}

model Settings {
  id                    String    @id @default(cuid())
  key                   String    @unique
  value                 String
  description          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model PricingConfig {
  id            String    @id @default(cuid())
  originalPrice Int      // in cents
  currentPrice  Int      // in cents
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  features      Feature[]
}

model Feature {
  id              String        @id @default(cuid())
  title           String
  description     String
  order           Int
  pricingConfigId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  pricingConfig   PricingConfig @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)
}
