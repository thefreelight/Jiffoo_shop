# Example environment variables
GITHUB_ID=your_github_id
GITHUB_SECRET=your_github_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=your_database_url

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database_name?schema=public"

# NextAuth.js
# Development
NEXTAUTH_URL="http://localhost:3000"
# Production
# NEXTAUTH_URL="https://jiffoo.com"
NEXTAUTH_SECRET="your_nextauth_secret"

# Environment
NODE_ENV="development"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# GitHub Configuration
GITHUB_ACCESS_TOKEN="your_github_access_token"
GITHUB_REPO_OWNER="your_github_username"
GITHUB_REPO_NAME="your_repo_name"
GITHUB_ID="your_github_oauth_app_id"
GITHUB_SECRET="your_github_oauth_app_secret"

# Stripe Configuration
STRIPE_SECRET_KEY="your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Service
RESEND_API_KEY="your_resend_api_key"

# Production Keys (uncomment and update for production)
# STRIPE_SECRET_KEY="your_production_stripe_secret_key"
# STRIPE_PUBLISHABLE_KEY="your_production_stripe_publishable_key"

# Production Webhook Endpoints:
# Stripe Webhook: https://jiffoo.com/api/webhooks/stripe
# GitHub Webhook: https://jiffoo.com/api/webhooks/github
